{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small" },
  "display": {
    "separator": " → "
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    "os",
    "kernel",
    "uptime",
    "shell",
    { "type": "de", "key": "Compositor" },
    { "type": "wm", "key": "WM" },
    "terminal",
    "cpu",
    "gpu",
    "memory",
    { "type": "disk", "format": "{used}/{total}" },
    { "type": "localip", "showIpv4": true, "showIpv6": false },
    "break",
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
