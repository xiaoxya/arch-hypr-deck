{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "pulseaudio", "network", "cpu", "memory", "battery", "custom/notification"],
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": { "active": "●", "default": "○" }
  },
  "hyprland/window": { "max-length": 40, "separate-outputs": true },
  "clock": {
    "format": "  {:%H:%M}",
    "format-alt": "  {:%Y-%m-%d %A %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },
  "tray": { "icon-size": 16, "spacing": 8 },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "  静音",
    "format-icons": { "default": ["", "", "", ""] },
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "  有线",
    "format-disconnected": "⚠ 断网",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "nm-connection-editor"
  },
  "cpu": { "format": " {usage}%", "interval": 3 },
  "memory": { "format": " {percentage}%", "interval": 3 },
  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{} ",
    "exec": "n=$(makoctl list 2>/dev/null | jq -r '.data | length' 2>/dev/null); [ \"${n:-0}\" -gt 0 ] 2>/dev/null && echo \" $n\" || echo ''",
    "on-click": "makoctl dismiss -a",
    "interval": 3
  }
}
